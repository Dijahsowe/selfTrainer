{
  "name": "selftrainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --raw --kill-others-on-fail --handle-input --default-input-target mobile \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev:web": "next dev -p 3001",
    "dev:mobile": "npm --prefix ../selftrainer-mobile run start -- --clear --lan --port 0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:mobile-api": "node scripts/test-mobile-api.mjs"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "openai": "^7.15.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
