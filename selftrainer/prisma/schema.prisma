generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  password       String?
  image          String?
  accounts       Account[]
  sessions       Session[]
  subjects       Subject[]
  studyMaterials StudyMaterial[]
  studyPlans     StudyPlan[]
  studySessions  StudySession[]
  summaries      Summary[]
  generationJobs GenerationJob[]
  quizAttempts   QuizAttempt[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id          String         @id @default(cuid())
  name        String
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials   StudyMaterial[]

  @@unique([userId, name])
}

model StudyMaterial {
  id             String          @id @default(cuid())
  title          String
  subject        String?
  subjectId      String?
  description    String?
  sourceText     String?
  wordCount      Int             @default(0)
  status         String          @default("completed")
  link           String?
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectRef     Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  summaries      Summary[]
  generationJobs GenerationJob[]
  flashcardDecks FlashcardDeck[]
  quizzes        Quiz[]

  @@index([userId])
  @@index([subjectId])
  @@index([createdAt])
}

model Summary {
  id              String        @id @default(cuid())
  studyMaterialId String
  userId          String
  content         String
  keyPoints       String
  keyTerms        String
  model           String
  promptVersion   String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  material        StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studyMaterialId])
}

model FlashcardDeck {
  id              String        @id @default(cuid())
  studyMaterialId String
  title           String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  material        StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  flashcards      Flashcard[]

  @@index([studyMaterialId])
}

model Flashcard {
  id          String        @id @default(cuid())
  deckId      String
  question    String
  answer      String
  explanation String?
  difficulty  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deck        FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model Quiz {
  id              String         @id @default(cuid())
  studyMaterialId String
  title           String
  difficulty      String         @default("mixed")
  questionCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  material        StudyMaterial  @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  questions       QuizQuestion[]
  attempts        QuizAttempt[]

  @@index([studyMaterialId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  questionText  String
  options       String
  correctAnswer String
  explanation   String
  difficulty    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id             String   @id @default(cuid())
  quizId         String
  userId         String
  score          Int
  totalQuestions Int
  answers        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model GenerationJob {
  id              String        @id @default(cuid())
  studyMaterialId String
  userId          String
  type            String
  status          String
  model           String
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  updatedAt       DateTime      @updatedAt
  material        StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model StudyPlan {
  id          String   @id @default(cuid())
  title       String
  topic       String
  goals       String?
  durationMin Int      @default(30)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudySession {
  id          String   @id @default(cuid())
  title       String
  topic       String
  durationMin Int      @default(30)
  completed   Boolean  @default(false)
  notes       String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
